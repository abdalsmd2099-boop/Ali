TYPE "UDT_MoveReq"
VERSION : 0.3
// one move request for fb_robotmove. one record = one block of program 20 plus its data.
// this is the only thing the layers above the move engine hand down.
// rule: a new field goes at the end. existing names never change.
//
// v0.3 (2026-11-02, path mode): a request may carry a path of up to 7 poses.
// they go to pose[1..7] of the robot, the seven standard path segments of module 1, and a
// block of program 20 drives them in one program run (block 5 rectangle, 6 and 7 drum circle).
// intPathLen = 0 is a single move as before: only udtPose goes out, to pose[51].
   STRUCT
      intBlock : Int;                 // block of program 20 = gate bool[50 + n], 1..8. stage 1: 1 = linear
      udtPose : "UDT_Pose";           // target pose -> srl pose[51]. for a path block: the last point of the path
      udtPose2 : "UDT_Pose";          // second pose (via point or circle center). reserved, needs pose[52] on the bus
      rBlend : Real;                  // mm, blending distance. 0 = stop exactly at the pose. path: every segment
      aorPar : Array[1..3] of Real;   // block parameters -> srl real[51..53]. circle: aorPar[1] = radius, [2] = arc angle
      intOverride : Int;              // %, 1..100 for this move. 0 = keep the override that is set
      xStopOnSensor : Bool;           // reserved for the laser: end the move when the sensor says so
      intId : Int;                    // free id of the caller (list index, step number). echoed in the state
      aoudtPath : Array[1..7] of "UDT_Pose";   // v0.3: the path, -> srl pose[1..7]. used when intPathLen > 0
      intPathLen : Int;                        // v0.3: 0 = single move, 1..7 = poses of the path that are used
   END_STRUCT;

END_TYPE
