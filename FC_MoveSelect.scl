FUNCTION "FC_MoveSelect" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
// ob1, right before fb_robotmove. the one writer of "DB_RobotMove".Req and .xReqStart.
// v0.2, stage 2: auto = the queue head, hand = the hmi request. auto wins.
// fb_robotmove does not know which source it serves.
//
// in auto the start is a level: head valid, engine idle, no error. the engine takes the
// edge. "not done" keeps one cycle gap after a move, so the next edge is clean.
   VAR_INPUT
      i_xHand : Bool;                     // hand source allowed: enable switch and auto off
      i_xAuto : Bool;                     // auto source allowed: enable switch and auto on
      i_udtMan : "UDT_MoveReq";           // "DB_RobotMove".Man.udtReq
      i_xManStart : Bool;                 // "DB_RobotMove".Man.xStart
      i_udtQueueHead : "UDT_MoveReq";     // "DB_MoveQueue".Head
      i_xQueueHeadValid : Bool;           // "DB_MoveQueue".xHeadValid
      i_udtMoveState : "UDT_MoveState";   // "DB_RobotMove".State
   END_VAR

   VAR_OUTPUT
      o_udtReq : "UDT_MoveReq";           // => "DB_RobotMove".Req
      o_xStart : Bool;                    // => "DB_RobotMove".xReqStart
   END_VAR

BEGIN
   IF #i_xAuto THEN
      #o_udtReq := #i_udtQueueHead;
      #o_xStart := #i_xQueueHeadValid
                   AND NOT #i_udtMoveState.xBusy
                   AND NOT #i_udtMoveState.xDone
                   AND NOT #i_udtMoveState.xError;
   ELSIF #i_xHand THEN
      #o_udtReq := #i_udtMan;
      #o_xStart := #i_xManStart;
   ELSE
      #o_udtReq := #i_udtMan;
      #o_xStart := FALSE;
   END_IF;
END_FUNCTION
