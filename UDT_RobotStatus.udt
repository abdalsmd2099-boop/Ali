TYPE "UDT_RobotStatus"
VERSION : 0.1
// what the robot answers, module 1 pi words 1..18, as named bits and values
// bit numbers from the movikit robotics manual 33956901, chapter 13.7, and the
// process data monitor screenshots of this machine (5-word pose, so pi 12 = segments)
   STRUCT
      // ---- pi 1 status word -------------------------------------------
      xReady : Bool;               // pi 1.0  software module ready
      xStoInactive : Bool;         // pi 1.1  true = sto not active
      xPowerOn : Bool;             // pi 1.2  output stages enabled
      xMoving : Bool;              // pi 1.4  robot moving, motors turning
      xReferenced : Bool;          // pi 1.5  all axes referenced
      xSetpointActive : Bool;      // pi 1.6  setpoints are processed
      xFault : Bool;               // pi 1.8  module fault
      xWarning : Bool;             // pi 1.9  module warning
      xAccessGranted : Bool;       // pi 1.13 true = fieldbus has access (robotmonitor not in control)
      xHandshakeEcho : Bool;       // pi 1.15 copy of po 1.15

      // ---- pi 2 program state ----------------------------------------
      xAutomatic : Bool;           // pi 2.0  true = automatic
      xPrgInitialized : Bool;      // pi 2.2
      xPrgRunning : Bool;          // pi 2.3
      xPrgPaused : Bool;           // pi 2.4
      xPrgFinished : Bool;         // pi 2.5
      xRepositionRequired : Bool;  // pi 2.6
      xRepositionActive : Bool;    // pi 2.7
      aoxAxisReferenced : Array[1..5] of Bool;   // pi 2.10 .. 2.14, axes x y z r1 r2

      // ---- pi 3 message -----------------------------------------------
      uiMsgId : UInt;              // message id. fault when xFault, warning when xWarning, else information

      // ---- pi 4 control type --------------------------------------------
      intPrgNr : Int;              // pi 4 bits 0..7, program number running
      xJogMode : Bool;             // pi 4.8
      xRefMode : Bool;             // pi 4.9
      xPrgMode : Bool;             // pi 4.10

      // ---- pi 5 motion state --------------------------------------------
      xOutsideWorkspace : Bool;    // pi 5.1
      xMotionCompleted : Bool;     // pi 5.2  all motion jobs done. not used as "finished", pulses per segment
      intConstellation : Int;      // pi 5 bits 8..15

      // ---- pi 6 ---------------------------------------------------------
      intSpeed : Int;              // mm/s, tcp speed

      // ---- pi 7..11 setpoint pose in base coordinates ---------------------
      udtPoseBcs : "UDT_Pose";     // x y z rotz roty, whole mm / deg

      // ---- pi 12 segments -----------------------------------------------
      intTargetPoseIdx : Int;      // pi 12 bits 0..7, index of the pose variable in use, 0 = none
      intRemainingSeg : Int;       // pi 12 bits 8..15, segments planned and not yet traveled

      // ---- pi 13 ---------------------------------------------------------
      intTargetDistance : Int;     // mm, remaining distance of the planned segments

      // ---- pi 14..18 setpoint pose of the joints ---------------------------
      aoiJoint : Array[1..5] of Int;   // j1 x, j2 y, j3 z in mm; j4, j5 in deg

      // ---- plc side -------------------------------------------------------
      xHsAlive : Bool;             // module 1 handshake echo moving, from "DB_App".HS_Alive
      xM2CommOK : Bool;            // module 2 fb communication_ok
      xCommOK : Bool;              // both of the above
   END_STRUCT;

END_TYPE
