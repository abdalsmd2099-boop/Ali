FUNCTION "FC_RobotStatusMap" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// ob30 network 4. maps the pi words of module 1 into named bits and values.
// the only writer of "DB_Robot".Status.
//
// i_aowPI is the static array PI of the module 1 instance db,
// "DB_MOVIKIT_Robotics-5AX".PI, Array[1..64] of Word. index n = robot word n,
// pi 1 = status word. only words 1..18 are used here, 19..64 are padding.
// slot 18, hw identifier 278, input words %IW19..%IW146.
//
// bit positions: manual 33956901 chapter 13.7.1 (pi 1..4) and 13.7.3 (flexible
// profile), checked against the process data monitor screenshots of this machine.
// positions are whole mm / deg on the bus (0 decimal places), signed.
   VAR_INPUT
      i_aowPI : Array[1..64] of Word;   // "DB_MOVIKIT_Robotics-5AX".PI
      i_xHsAlive : Bool;                // "DB_App".HS_Alive
      i_xM2CommOK : Bool;               // "DB_App".Srl.CommOK, module 2 fb
   END_VAR

   VAR_OUTPUT
      o_udtStatus : "UDT_RobotStatus";  // => "DB_Robot".Status
   END_VAR

   VAR_TEMP
      tmp_i : Int;
   END_VAR

BEGIN
   // ---- pi 1 status word -----------------------------------------------
   #o_udtStatus.xReady          := #i_aowPI[1].%X0;
   #o_udtStatus.xStoInactive    := #i_aowPI[1].%X1;
   #o_udtStatus.xPowerOn        := #i_aowPI[1].%X2;
   #o_udtStatus.xMoving         := #i_aowPI[1].%X4;
   #o_udtStatus.xReferenced     := #i_aowPI[1].%X5;
   #o_udtStatus.xSetpointActive := #i_aowPI[1].%X6;
   #o_udtStatus.xFault          := #i_aowPI[1].%X8;
   #o_udtStatus.xWarning        := #i_aowPI[1].%X9;
   #o_udtStatus.xAccessGranted  := #i_aowPI[1].%X13;
   #o_udtStatus.xHandshakeEcho  := #i_aowPI[1].%X15;

   // ---- pi 2 program state -----------------------------------------------
   #o_udtStatus.xAutomatic          := #i_aowPI[2].%X0;
   #o_udtStatus.xPrgInitialized     := #i_aowPI[2].%X2;
   #o_udtStatus.xPrgRunning         := #i_aowPI[2].%X3;
   #o_udtStatus.xPrgPaused          := #i_aowPI[2].%X4;
   #o_udtStatus.xPrgFinished        := #i_aowPI[2].%X5;
   #o_udtStatus.xRepositionRequired := #i_aowPI[2].%X6;
   #o_udtStatus.xRepositionActive   := #i_aowPI[2].%X7;
   #o_udtStatus.aoxAxisReferenced[1] := #i_aowPI[2].%X10;   // x
   #o_udtStatus.aoxAxisReferenced[2] := #i_aowPI[2].%X11;   // y
   #o_udtStatus.aoxAxisReferenced[3] := #i_aowPI[2].%X12;   // z
   #o_udtStatus.aoxAxisReferenced[4] := #i_aowPI[2].%X13;   // r1, rotz
   #o_udtStatus.aoxAxisReferenced[5] := #i_aowPI[2].%X14;   // r2, roty

   // ---- pi 3 message id ---------------------------------------------------
   #o_udtStatus.uiMsgId := WORD_TO_UINT(#i_aowPI[3]);

   // ---- pi 4 program number and control type --------------------------------
   #o_udtStatus.intPrgNr  := WORD_TO_INT(#i_aowPI[4] AND W#16#00FF);
   #o_udtStatus.xJogMode  := #i_aowPI[4].%X8;
   #o_udtStatus.xRefMode  := #i_aowPI[4].%X9;
   #o_udtStatus.xPrgMode  := #i_aowPI[4].%X10;

   // ---- pi 5 motion state ---------------------------------------------------
   #o_udtStatus.xOutsideWorkspace := #i_aowPI[5].%X1;
   #o_udtStatus.xMotionCompleted  := #i_aowPI[5].%X2;
   #o_udtStatus.intConstellation  := WORD_TO_INT(SHR(IN := #i_aowPI[5], N := 8));

   // ---- pi 6 tcp speed ----------------------------------------------------------
   #o_udtStatus.intSpeed := WORD_TO_INT(#i_aowPI[6]);

   // ---- pi 7..11 setpoint pose in base coordinates --------------------------------
   #o_udtStatus.udtPoseBcs.rX    := INT_TO_REAL(WORD_TO_INT(#i_aowPI[7]));
   #o_udtStatus.udtPoseBcs.rY    := INT_TO_REAL(WORD_TO_INT(#i_aowPI[8]));
   #o_udtStatus.udtPoseBcs.rZ    := INT_TO_REAL(WORD_TO_INT(#i_aowPI[9]));
   #o_udtStatus.udtPoseBcs.rRotZ := INT_TO_REAL(WORD_TO_INT(#i_aowPI[10]));
   #o_udtStatus.udtPoseBcs.rRotY := INT_TO_REAL(WORD_TO_INT(#i_aowPI[11]));

   // ---- pi 12 target pose index and remaining segments -----------------------------
   #o_udtStatus.intTargetPoseIdx := WORD_TO_INT(#i_aowPI[12] AND W#16#00FF);
   #o_udtStatus.intRemainingSeg  := WORD_TO_INT(SHR(IN := #i_aowPI[12], N := 8));

   // ---- pi 13 remaining distance ------------------------------------------------------
   #o_udtStatus.intTargetDistance := WORD_TO_INT(#i_aowPI[13]);

   // ---- pi 14..18 joints ---------------------------------------------------------------
   FOR #tmp_i := 1 TO 5 DO
      #o_udtStatus.aoiJoint[#tmp_i] := WORD_TO_INT(#i_aowPI[13 + #tmp_i]);
   END_FOR;

   // ---- plc side --------------------------------------------------------------------------
   #o_udtStatus.xHsAlive   := #i_xHsAlive;
   #o_udtStatus.xM2CommOK  := #i_xM2CommOK;
   #o_udtStatus.xCommOK    := #i_xHsAlive AND #i_xM2CommOK;
END_FUNCTION
