// ob1, stage 2 – wiring reference, not an importable block.
// ob1 is lad: one box per network, in THIS order. the order is the data flow of one cycle:
//    robot mode (2026-11-02) -> teach -> cube job, drum job (push) -> job mux (picks the active job) -> queue (stores)
//          -> select (picks the head) -> engine (moves) -> alarms
// 2026-10-31: the drum job and the job mux came in. "IDB_ScanDrumJob" is a new single instance.
//
// stage 1 had one network "robot move" with fc_moveselect + fb_robotmove.
// stage 2: fc_moveselect gets four new pins (v0.2), three networks come in front, one after.
// 2026-11-04: one file for everything. the path mode pins are in (i_xPathMode on both jobs,
// io_aoudtPath and io_aorPathBlend on the engine, automatic_today.md part 7). they do nothing
// while "DB_Recipe".xPathMode is off.
// 2026-11-05: three pins after the review (docs/engine_review_2026-11-04.md): the cube job gets
// i_intBlocksInPrg20, fc_moveselect v0.3 gets i_xJobRunning, and i_xActualValid of both jobs
// also wants the robot standing. engine v0.7, cube job v0.7, cube buttons v0.2: no pin change.

// ---------------------------------------------------------------------------
// network: robot mode  (2026-11-02, step 1a of AUTOMATIC_TODAY.md)
// the one writer of "DB_App".Cmd.Automatic. after network 8 (enable), before teach.
// automatic is the rest state, manual while a jog or home is wanted and nothing of ours moves.
// in lad: the 16 contacts of i_xJogWanted are parallel branches in front of the pin.
// the old screen switch on Cmd.Automatic must go (a lamp on "DB_Robot".Status.xAutomatic instead).
// ---------------------------------------------------------------------------
"IDB_RobotMode"(i_xJogWanted  := "DB_App".Cmd.Jog_Pos_X OR "DB_App".Cmd.Jog_Neg_X
                              OR "DB_App".Cmd.Jog_Pos_Y OR "DB_App".Cmd.Jog_Neg_Y
                              OR "DB_App".Cmd.Jog_Pos_Z OR "DB_App".Cmd.Jog_Neg_Z
                              OR "DB_App".Cmd.Jog_Pos_R1 OR "DB_App".Cmd.Jog_Neg_R1
                              OR "DB_App".Cmd.Jog_Pos_R2 OR "DB_App".Cmd.Jog_Neg_R2
                              OR "DB_App".Cmd.Home_X1 OR "DB_App".Cmd.Home_Y1 OR "DB_App".Cmd.Home_Z1
                              OR "DB_App".Cmd.Home_R1 OR "DB_App".Cmd.Home_R2
                              OR "DB_App".Home.active,
                i_xAuto       := "DB_RobotJob".Man.xAuto,
                i_xEngineBusy := "DB_RobotMove".State.xBusy,
                i_udtStatus   := "DB_Robot".Status,
                io_xAutomatic := "DB_App".Cmd.Automatic);
                // o_xManual stays open, or goes to a lamp tag of your choice

// ---------------------------------------------------------------------------
// network: cube buttons  (2026-11-03). the buttons of the cube box, no hmi scripts.
// before teach, so a pulse is seen in the same cycle. from now on the one writer of
// "DB_RobotJob".Teach.intPoseNr, .xTeach, .xClear. hmi_cube_howto.md
// ---------------------------------------------------------------------------
"IDB_CubeButtons"(i_xTeachHome    := "DB_RobotHand".Btn.xTeachHome,
                  i_xTeachStart   := "DB_RobotHand".Btn.xTeachStart,
                  i_xTeachC1      := "DB_RobotHand".Btn.xTeachC1,
                  i_xTeachNr      := "DB_RobotHand".Btn.xTeachNr,
                  i_xClearNr      := "DB_RobotHand".Btn.xClearNr,
                  i_intPoseNrReq  := "DB_RobotHand".Btn.intPoseNr,
                  i_xGoStart      := "DB_RobotHand".Btn.xGoStart,
                  i_xGoC1         := "DB_RobotHand".Btn.xGoC1,
                  i_xAck          := "DB_RobotHand".Btn.xAck,
                  i_aoudtP        := "DB_Poses".aoudtP,
                  i_aoxValid      := "DB_Poses".aoxValid,
                  i_rLength       := "DB_Recipe".Cube.rLength,
                  i_rWidth        := "DB_Recipe".Cube.rWidth,
                  i_xEnable       := "DB_RobotMove".Man.xEnable,
                  i_xAuto         := "DB_RobotJob".Man.xAuto,
                  i_xEngineBusy   := "DB_RobotMove".State.xBusy,
                  io_udtMan       := "DB_RobotMove".Man.udtReq,
                  io_xManStart    := "DB_RobotMove".Man.xStart,
                  io_xReset       := "DB_RobotMove".Man.xReset,
                  io_xAbort       := "DB_RobotJob".Man.xAbort,
                  o_intPoseNr     => "DB_RobotJob".Teach.intPoseNr,
                  o_xTeach        => "DB_RobotJob".Teach.xTeach,
                  o_xClear        => "DB_RobotJob".Teach.xClear,
                  o_xTeachAllowed => "DB_RobotHand".Lamp.xTeachAllowed,
                  o_xGoAllowed    => "DB_RobotHand".Lamp.xGoAllowed,
                  o_xCubeReady    => "DB_RobotHand".Lamp.xCubeReady,
                  o_xComputed     => "DB_RobotHand".Lamp.xComputed);

// ---------------------------------------------------------------------------
// network: robot teach  (unchanged. Teach.intPoseNr, .xTeach, .xClear now come from the cube buttons)
// ---------------------------------------------------------------------------
"IDB_Teach"(i_xTeach       := "DB_RobotJob".Teach.xTeach,
            i_xClearPose   := "DB_RobotJob".Teach.xClear,
            i_intPoseNr    := "DB_RobotJob".Teach.intPoseNr,
            i_xAllowed     := "DB_RobotMove".Man.xEnable AND NOT "DB_RobotJob".Man.xAuto AND NOT "DB_RobotMove".State.xBusy,
            i_xActualValid := "DB_Robot".Status.xReferenced AND "DB_Robot".Status.xCommOK,
            i_udtActual    := "DB_Robot".Status.udtPoseBcs,
            io_aoudtP      := "DB_Poses".aoudtP,
            io_aoxValid    := "DB_Poses".aoxValid,
            o_xTaught      => "DB_RobotJob".Teach.xTaught,
            o_xRefused     => "DB_RobotJob".Teach.xRefused,
            o_intLastTaught => "DB_RobotJob".Teach.intLastTaught);

// ---------------------------------------------------------------------------
// network: robot job, scan cube
// 2026-10-31: the start is gated by the job selector, the outputs go to "DB_RobotJob".Cube.
// (before: outputs straight to Push and State. fc_jobmux writes those now)
// ---------------------------------------------------------------------------
"IDB_ScanCubeJob"(i_xStart        := "DB_RobotJob".Man.xStart AND ("DB_RobotJob".Man.intJob = 1),
                  i_xAbort        := "DB_RobotJob".Man.xAbort,
                  i_xAuto         := "DB_RobotJob".Man.xAuto AND "DB_RobotMove".Man.xEnable,
                  i_intOverride   := "DB_RobotJob".Man.intOverride,
                  i_aoudtP        := "DB_Poses".aoudtP,
                  i_aoxValid      := "DB_Poses".aoxValid,
                  i_rSafeZ        := "DB_Poses".rSafeZ,
                  i_udtMoveState  := "DB_RobotMove".State,
                  i_intQueueCount := "DB_MoveQueue".intCount,
                  i_rLength       := "DB_Recipe".Cube.rLength,     // v0.2, 2026-11-02: the cube by its dimensions
                  i_rWidth        := "DB_Recipe".Cube.rWidth,
                  i_rAngle        := "DB_Recipe".Cube.rAngle,
                  i_xFromHere     := "DB_Recipe".xFromHere,               // v0.3: scan from here
                  i_udtActual     := "DB_Robot".Status.udtPoseBcs,
                  i_xActualValid  := "DB_Robot".Status.xReferenced AND "DB_Robot".Status.xCommOK
                                     AND NOT "DB_Robot".Status.xMoving AND NOT "DB_Robot".Status.xPrgRunning,   // 2026-11-05: standing, else "scan from here" takes a pose on the way
                  i_xPathMode     := "DB_Recipe".xPathMode,                 // v0.5: path mode, off = as before
                  i_xNoTurn       := "DB_Recipe".xNoTurn,                   // v0.6 (2026-11-04): no turn at the corners, off = as before
                  i_intBlocksInPrg20 := "DB_RobotMove".Cfg.intBlocksInPrg20,   // v0.7 (2026-11-05): path mode only with block 5 in program 20
                  o_xPushReq      => "DB_RobotJob".Cube.xPushReq,
                  o_udtPush       => "DB_RobotJob".Cube.udtPush,
                  o_xClear        => "DB_RobotJob".Cube.xClear,
                  o_udtState      => "DB_RobotJob".Cube.udtState);

// ---------------------------------------------------------------------------
// network: robot job, scan drum  (2026-10-31)
// ---------------------------------------------------------------------------
"IDB_ScanDrumJob"(i_xStart        := "DB_RobotJob".Man.xStart AND ("DB_RobotJob".Man.intJob = 2),
                  i_xAbort        := "DB_RobotJob".Man.xAbort,
                  i_xAuto         := "DB_RobotJob".Man.xAuto AND "DB_RobotMove".Man.xEnable,
                  i_intOverride   := "DB_RobotJob".Man.intOverride,
                  i_aoudtP        := "DB_Poses".aoudtP,
                  i_aoxValid      := "DB_Poses".aoxValid,
                  i_rSafeZ        := "DB_Poses".rSafeZ,
                  i_rZ            := "DB_Recipe".Drum.rZ,            // 2026-11-02: the drum numbers live in DB_Recipe
                  i_rRadius       := "DB_Recipe".Drum.rRadius,
                  i_rStartAngle   := "DB_Recipe".Drum.rStartAngle,
                  i_rRotZOffset   := "DB_Recipe".Drum.rRotZOffset,
                  i_xClockwise    := "DB_Recipe".Drum.xClockwise,
                  i_udtMoveState  := "DB_RobotMove".State,
                  i_intQueueCount := "DB_MoveQueue".intCount,
                  i_xFromHere     := "DB_Recipe".xFromHere,               // v0.2: scan from here
                  i_udtActual     := "DB_Robot".Status.udtPoseBcs,
                  i_xActualValid  := "DB_Robot".Status.xReferenced AND "DB_Robot".Status.xCommOK
                                     AND NOT "DB_Robot".Status.xMoving AND NOT "DB_Robot".Status.xPrgRunning,   // 2026-11-05: standing
                  i_xPathMode     := "DB_Recipe".xPathMode,                 // v0.4: path mode, off = as before
                  o_udtOut        => "DB_RobotJob".Drum);

// ---------------------------------------------------------------------------
// network: job mux, the one writer of "DB_RobotJob".Push and .State  (2026-10-31)
// ---------------------------------------------------------------------------
"FC_JobMux"(i_intJob        := "DB_RobotJob".Man.intJob,
            i_udtCube       := "DB_RobotJob".Cube,
            i_udtDrum       := "DB_RobotJob".Drum,
            io_intJobActive := "DB_RobotJob".intJobActive,
            o_xPushReq      => "DB_RobotJob".Push.xReq,
            o_udtPush       => "DB_RobotJob".Push.udtMove,
            o_xClear        => "DB_RobotJob".Push.xClear,
            o_udtState      => "DB_RobotJob".State);

// ---------------------------------------------------------------------------
// network: move queue
// ---------------------------------------------------------------------------
"IDB_MoveQueue"(i_xPush        := "DB_RobotJob".Push.xReq,
                i_udtPush      := "DB_RobotJob".Push.udtMove,
                i_xPop         := "DB_RobotMove".State.xDone,
                i_xClear       := "DB_RobotJob".Push.xClear,
                io_udtQ        := "DB_MoveQueue".Q,
                o_udtHead      => "DB_MoveQueue".Head,
                o_xHeadValid   => "DB_MoveQueue".xHeadValid,
                o_intCount     => "DB_MoveQueue".intCount,
                o_xFull        => "DB_MoveQueue".xFull,
                o_xPushRefused => "DB_MoveQueue".xPushRefused);

// ---------------------------------------------------------------------------
// network: robot move  (stage 1 network, fc_moveselect v0.3 with the job-running pin (2026-11-05),
// fb_robotmove v0.7 with two in-out pins on "DB_RobotPath" at the end, 2026-11-04)
// ---------------------------------------------------------------------------
"FC_MoveSelect"(i_xHand           := "DB_RobotMove".Man.xEnable AND NOT "DB_RobotJob".Man.xAuto,
                i_xAuto           := "DB_RobotMove".Man.xEnable AND "DB_RobotJob".Man.xAuto,
                i_udtMan          := "DB_RobotMove".Man.udtReq,
                i_xManStart       := "DB_RobotMove".Man.xStart,
                i_udtQueueHead    := "DB_MoveQueue".Head,
                i_xQueueHeadValid := "DB_MoveQueue".xHeadValid,
                i_udtMoveState    := "DB_RobotMove".State,
                i_xJobRunning     := "DB_RobotJob".State.xRunning,          // v0.3 (2026-11-05): no start from the queue without a running job
                o_udtReq          => "DB_RobotMove".Req,
                o_xStart          => "DB_RobotMove".xReqStart);

"IDB_RobotMove"(i_xStart           := "DB_RobotMove".xReqStart,          // unchanged from stage 1
                i_xEnable          := "DB_RobotMove".Man.xEnable,
                i_xReset           := "DB_RobotMove".Man.xReset,
                i_xSensorStop      := FALSE,
                i_udtReq           := "DB_RobotMove".Req,
                i_intBlocksInPrg20 := "DB_RobotMove".Cfg.intBlocksInPrg20,
                i_udtStatus        := "DB_Robot".Status,
                i_intEchoBlock     := "DB_MOVIKIT_ROBOTICS_Module2".SrlRealRaw[1],
                i_intEchoRun       := "DB_MOVIKIT_ROBOTICS_Module2".SrlRealRaw[2],
                io_aorSrlPose      := "DB_App".Srl.Pose,
                io_aorSrlPar       := "DB_App".Srl.Par,
                io_aoxSrlGate      := "DB_App".Srl.Gate,
                io_xGateEnable     := "DB_App".Srl.GateEnable,
                io_xStart          := "DB_App".Cmd.Start,
                io_intPrgNr        := "DB_App".Cmd.ProgramNumber,
                io_intOverride     := "DB_App".Cmd.Override,
                io_aoudtPath       := "DB_RobotPath".aoudtP,                  // v0.6: pose[1..7], path mode
                io_aorPathBlend    := "DB_RobotPath".aorBlend,                // v0.6
                o_udtState         => "DB_RobotMove".State);

// ---------------------------------------------------------------------------
// network: robot alarms
// ---------------------------------------------------------------------------
"FC_RobotAlarms"(i_udtMoveState := "DB_RobotMove".State,
                 i_udtJobState  := "DB_RobotJob".State,
                 i_udtStatus    := "DB_Robot".Status,
                 o_aoxAlarm     => "DB_RobotJob".aoxAlarm);

// ---------------------------------------------------------------------------
// later, step 9, when the framework is in the project: fb_actrobot replaces the job box.
// it pushes into the same "DB_RobotJob".Push, so the queue and the engine do not change.
// ---------------------------------------------------------------------------
