// ob1, new network "robot move" – wiring reference, not an importable block.
// ob1 is lad: place the two boxes in one network, in this order, and wire the pins as below.
// the instance db of fb_robotmove is a single instance named "IDB_RobotMove".
//
// network: robot move
//   box 1: fc_moveselect     -> the one writer of the active request
//   box 2: fb_robotmove      -> the single movement

"FC_MoveSelect"(i_xHand     := "DB_RobotMove".Man.xEnable,
                i_udtMan    := "DB_RobotMove".Man.udtReq,
                i_xManStart := "DB_RobotMove".Man.xStart,
                o_udtReq    => "DB_RobotMove".Req,
                o_xStart    => "DB_RobotMove".xReqStart);

"IDB_RobotMove"(i_xStart           := "DB_RobotMove".xReqStart,
                i_xEnable          := "DB_RobotMove".Man.xEnable,
                i_xReset           := "DB_RobotMove".Man.xReset,
                i_xSensorStop      := FALSE,                                    // laser, later
                i_udtReq           := "DB_RobotMove".Req,
                i_intBlocksInPrg20 := "DB_RobotMove".Cfg.intBlocksInPrg20,
                i_udtStatus        := "DB_Robot".Status,
                i_intEchoBlock     := "DB_MOVIKIT_ROBOTICS_Module2".SrlRealRaw[1],   // srl real[71]
                i_intEchoRun       := "DB_MOVIKIT_ROBOTICS_Module2".SrlRealRaw[2],   // srl real[72]
                io_aorSrlPose      := "DB_App".Srl.Pose,
                io_aorSrlPar       := "DB_App".Srl.Par,
                io_aoxSrlGate      := "DB_App".Srl.Gate,
                io_xGateEnable     := "DB_App".Srl.GateEnable,
                io_xStart          := "DB_App".Cmd.Start,
                io_intPrgNr        := "DB_App".Cmd.ProgramNumber,
                io_intOverride     := "DB_App".Cmd.Override,
                o_udtState         => "DB_RobotMove".State);

// ob30 does not change: network 1 handshake, 2 module 1, 3 module 2, 4 fc_robotstatusmap.
// network 2 keeps  start := ("DB_App".Cmd.Start AND "DB_App".ReadyToStart).
//
// if SrlRealRaw is not Int: use the scaled values instead,
//    i_intEchoBlock := REAL_TO_INT("DB_MOVIKIT_ROBOTICS_Module2".Param1_fb)
//    i_intEchoRun   := REAL_TO_INT("DB_MOVIKIT_ROBOTICS_Module2".Param2_fb)
