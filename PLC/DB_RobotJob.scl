DATA_BLOCK "DB_RobotJob"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// stage 2 operator side: automatic switch, job buttons, teach buttons, job state, alarms.
// writers:  hmi -> Man, Teach.x*/intPoseNr      fc_jobmux -> Push, State, intJobActive
//           fb_teach -> Teach.xTaught/xRefused/intLastTaught      fc_robotalarms -> aoxAlarm
//           fb_scancubejob -> Cube      fb_scandrumjob -> Drum      (2026-10-31)
NON_RETAIN
   VAR
      Man : STRUCT                         // hmi
         xAuto : Bool;                     // switch: automatic. off = hand, single moves from the robot move screen
         xStart : Bool;                    // button, momentary: start the job
         xAbort : Bool;                    // button, momentary: abort the job, also clears a job error
         intOverride : Int := 10;          // % for every move of the job
         intJob : Int := 1;                // 1 scan cube, 2 scan drum. taken over by fc_jobmux when no job runs
      END_STRUCT;

      Teach : STRUCT                       // hmi, poses screen
         xTeach : Bool;                    // button, momentary: store the actual pose into pose intPoseNr
         xClear : Bool;                    // button, momentary: mark pose intPoseNr as not taught
         intPoseNr : Int := 1;             // 1..50
         xTaught : Bool;                   // one cycle, from fb_teach
         xRefused : Bool;                  // one cycle, from fb_teach
         intLastTaught : Int;              // from fb_teach
      END_STRUCT;

      Push : STRUCT                        // job -> queue. one writer: fc_jobmux
         xReq : Bool;                      // true in a cycle that pushes udtMove
         udtMove : "UDT_MoveReq";
         xClear : Bool;                    // true in a cycle that empties the queue
      END_STRUCT;

      State : "UDT_JobState";              // one writer: fc_jobmux, copy of the active job

      aoxAlarm : Array[1..32] of Bool;     // one writer: fc_robotalarms. hmi discrete alarms, texts in hmi_stage2.md

      Cube : "UDT_JobOut";                 // one writer: fb_scancubejob   (2026-10-31)
      Drum : "UDT_JobOut";                 // one writer: fb_scandrumjob
      intJobActive : Int;                  // one writer: fc_jobmux. 1 cube, 2 drum. hmi shows it
   END_VAR

BEGIN

END_DATA_BLOCK
