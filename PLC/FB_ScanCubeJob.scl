FUNCTION_BLOCK "FB_ScanCubeJob"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.6
// stage 2 step 7. one button, one cube scan. turns goals.md section 3 into queue entries.
// no motion code here: it builds a list of poses, checks all of them, then pushes them
// into fb_movequeue. the engine does the rest.
// runs in ob1 before fb_movequeue, instance "IDB_ScanCubeJob".
//
// v0.2 (2026-11-02): the cube by its dimensions. when i_rLength and i_rWidth are both > 0,
// corners 2, 3, 4 and the approach are computed from corner 1 (pose 4) and the three numbers
// of "DB_Recipe".Cube:
//    corner 2 = corner 1 + length along the angle             side 1
//    corner 3 = corner 2 + width, turned 90 deg to the left    side 2
//    corner 4 = corner 1 + width, turned 90 deg to the left    side 3 ends here, side 4 goes back to corner 1
//    approach = corner 1 at safe z
// with angle 0, corner 1 is the corner with the smallest x and the smallest y: side 1 runs
// along +x, side 2 along +y. when length or width is 0, the taught corners 5, 6, 7 and the
// taught approach 3 are used (v0.1).
//
// v0.3 (2026-11-02): "scan from here". with i_xFromHere the actual pose of the robot is corner 1,
// nothing is taught and nothing is stored. the list begins with side 1 (index 4), the robot
// stands on corner 1 already. needs length and width and a valid actual pose, else error 6.
//
// v0.4 (2026-11-02): in dimension mode the tool turns ROTZ_STEP (+90 deg) at every corner:
// corner 1 at rotz -180, corner 2 -90, corner 3 0, corner 4 +90, back at corner 1 +180.
// no wrap on purpose: corner 1 must stand at rotz -180, else error 4 at index 11 before any move.
//
// v0.5 (2026-11-02, path mode. one file since 2026-11-04): with i_xPathMode the seven moves of the
// rectangle (side 1, turn, side 2, turn, side 3, turn, side 4) go out as ONE queue entry with
// block 5 and the seven poses in aoudtPath, pose[1..7] on the robot, one program run. the
// moves before (to start, approach, to corner 1) and after (turn at corner 1, lift, start,
// home) stay single moves. 8 entries instead of 14. the path entry has id 15, hmi text
// TL_Move 15 "rectangle". needs fb_robotmove v0.6 and block 5 in program 20. off = exactly v0.4.
//
// v0.6 (2026-11-04): "no turn", i_xNoTurn = "DB_Recipe".xNoTurn. the tool keeps the orientation
// of corner 1 all the way round, in dimension mode and in taught mode. the four turn entries
// (5, 7, 9, 11) would be moves of zero length and are NOT pushed: 10 moves with home, 9 without,
// 7 or 6 with "scan from here". in path mode the rectangle has 4 segments instead of 7.
// corner 1 may then stand at any rotz, nothing adds to it. for a test, or a sensor that does not
// care which side it faces. off = exactly v0.5.
//
// how the corners are taught in taught mode (poses 4..7 = c1..c4):
//    teach every corner with the tool facing the side that STARTS there.
//    side n is then "go to the xyz of corner n+1 with the orientation of corner n",
//    and a "turn" is "stay at corner n+1, take its own orientation".
//
// the list (intId = list index, the hmi text list TL_Move):
//     1 start (2)         2 approach          3 corner 1 (4)
//     4 side 1            5 turn at c2        6 side 2            7 turn at c3
//     8 side 3            9 turn at c4       10 side 4           11 turn at c1
//    12 lift to safe z   13 start (2)        14 home (1), only if pose 1 is taught
//    15 = the path entry of path mode: list 4..10 in one program run
   VAR_INPUT
      i_xStart : Bool;                          // hmi button, momentary. edge inside
      i_xAbort : Bool;                          // hmi button, momentary. also clears a job error
      i_xAuto : Bool;                           // auto switch. falls while running = abort
      i_intOverride : Int;                      // % for every move
      i_aoudtP : Array[1..50] of "UDT_Pose";    // "DB_Poses".aoudtP
      i_aoxValid : Array[1..50] of Bool;        // "DB_Poses".aoxValid
      i_rSafeZ : Real;                          // "DB_Poses".rSafeZ
      i_udtMoveState : "UDT_MoveState";         // "DB_RobotMove".State
      i_intQueueCount : Int;                    // "DB_MoveQueue".intCount
      i_rLength : Real;                         // "DB_Recipe".Cube.rLength, mm. 0 = taught corners   (v0.2)
      i_rWidth : Real;                          // "DB_Recipe".Cube.rWidth, mm                          (v0.2)
      i_rAngle : Real;                          // "DB_Recipe".Cube.rAngle, deg, direction of side 1. 0 = +x   (v0.2)
      i_xFromHere : Bool;                       // "DB_Recipe".xFromHere: the actual pose is corner 1   (v0.3)
      i_udtActual : "UDT_Pose";                 // "DB_Robot".Status.udtPoseBcs                          (v0.3)
      i_xActualValid : Bool;                    // "DB_Robot".Status.xReferenced AND .xCommOK            (v0.3)
      i_xPathMode : Bool;                       // "DB_Recipe".xPathMode: the rectangle as one program run   (v0.5)
      i_xNoTurn : Bool;                         // "DB_Recipe".xNoTurn: no turn at the corners, the turn entries are not pushed   (v0.6)
   END_VAR

   VAR_OUTPUT
      o_xPushReq : Bool;                        // => "DB_RobotJob".Push.xReq
      o_udtPush : "UDT_MoveReq";                // => "DB_RobotJob".Push.udtMove
      o_xClear : Bool;                          // => "DB_RobotJob".Push.xClear
      o_udtState : "UDT_JobState";              // => "DB_RobotJob".State
   END_VAR

   VAR
      intStep : Int;                            // 0 idle, 10 build, 20 push, 30 run, 90 error
      xStartOld : Bool;
      xAbortOld : Bool;
      aoudtPoseList : Array[1..14] of "UDT_Pose";
      aoudtList : Array[1..14] of "UDT_MoveReq";   // one single move per list index
      aoudtOut : Array[1..14] of "UDT_MoveReq";    // v0.5: what is pushed, in order. singles, or singles + the path entry
      intOutLen : Int;
      intListLen : Int;
      intPushIdx : Int;
      intFirst : Int;                           // first list index that is pushed: 1, or 4 with "scan from here"
   END_VAR

   VAR_TEMP
      tmp_xStartEdge : Bool;
      tmp_xAbortEdge : Bool;
      tmp_i : Int;
      tmp_k : Int;
      tmp_intErr : Int;
      tmp_intPoseErr : Int;
      tmp_xDim : Bool;                          // v0.2: the cube by its dimensions
      tmp_xHere : Bool;                         // v0.3: scan from here
      tmp_rRad : Real;
      tmp_rCos : Real;
      tmp_rSin : Real;
      tmp_udtC1 : "UDT_Pose";
      tmp_udtC2 : "UDT_Pose";
      tmp_udtC3 : "UDT_Pose";
      tmp_udtC4 : "UDT_Pose";
      tmp_udtApp : "UDT_Pose";
      tmp_rRotZEnd : Real;                      // v0.4: rotz back at corner 1 after the four turns
      tmp_xTurn : Bool;                         // v0.6: the list index is a turn entry (5, 7, 9, 11)
      tmp_intSeg : Int;                         // v0.6: segments put into the path entry
   END_VAR

   VAR CONSTANT
      P_HOME : Int := 1;
      P_START : Int := 2;
      P_APPROACH : Int := 3;
      P_C1 : Int := 4;
      P_C2 : Int := 5;
      P_C3 : Int := 6;
      P_C4 : Int := 7;
      BLOCK_LIN : Int := 1;                     // program 20 block 1
      BLOCK_RECT : Int := 5;                    // v0.5: program 20 block 5, seven lin on pose[1..7]
      ID_PATH : Int := 15;                      // v0.5: id of the path entry, hmi text TL_Move 15
      PATH_FIRST : Int := 4;                    // v0.5: list 4..10 go into the path entry
      PATH_LAST : Int := 10;
      DEG_TO_RAD : Real := 0.017453293;
      ROTZ_STEP : Real := 90.0;                 // v0.4: the tool turns this much at every corner. +90 = left turns, like the path
   END_VAR

BEGIN
   // ---- edges and pulses -------------------------------------------------------
   #tmp_xStartEdge := #i_xStart AND NOT #xStartOld;
   #xStartOld := #i_xStart;
   #tmp_xAbortEdge := #i_xAbort AND NOT #xAbortOld;
   #xAbortOld := #i_xAbort;

   #o_xPushReq := FALSE;
   #o_xClear := FALSE;
   #o_udtState.xDone := FALSE;

   // ---- abort while running: button, auto switch off, or the engine went into error --------
   IF #intStep >= 10 AND #intStep <= 30 THEN
      IF #tmp_xAbortEdge OR NOT #i_xAuto THEN
         #o_xClear := TRUE;                     // the running move finishes, nothing follows
         #o_udtState.xRunning := FALSE;
         #intStep := 0;
      ELSIF #i_udtMoveState.xError THEN
         #o_xClear := TRUE;
         #o_udtState.intErrId := 10;
         #o_udtState.intEngineErr := #i_udtMoveState.intErrId;
         #o_udtState.intMoveActive := #i_udtMoveState.intIdActive;
         #intStep := 90;
      END_IF;
   END_IF;

   CASE #intStep OF
      0: // idle
         #o_udtState.xRunning := FALSE;
         IF #tmp_xStartEdge AND #i_xAuto THEN
            #o_udtState.xError := FALSE;
            #o_udtState.intErrId := 0;
            #o_udtState.intEngineErr := 0;
            #intStep := 10;
         END_IF;

      10: // build the list and check it. nothing goes out of this block yet
         #tmp_intErr := 0;
         #tmp_xDim := #i_rLength > 0.0 AND #i_rWidth > 0.0;   // v0.2: both given = computed corners
         #tmp_xHere := #i_xFromHere AND #tmp_xDim AND #i_xActualValid;   // v0.3

         IF #tmp_xHere THEN
            IF NOT #i_aoxValid[#P_START] THEN
               #tmp_intErr := 1;                // start not taught
            END_IF;
         ELSIF #tmp_xDim THEN
            IF NOT #i_aoxValid[#P_START] OR NOT #i_aoxValid[#P_C1] THEN
               #tmp_intErr := 1;                // start or corner 1 not taught
            END_IF;
         ELSE
            FOR #tmp_i := #P_START TO #P_C4 DO
               IF NOT #i_aoxValid[#tmp_i] THEN
                  #tmp_intErr := 1;             // a cube pose is not taught
               END_IF;
            END_FOR;
         END_IF;
         IF #i_rSafeZ <= 0.0 THEN
            #tmp_intErr := 2;                   // safe z not set
         END_IF;
         IF #i_udtMoveState.xBusy OR #i_udtMoveState.xError THEN
            #tmp_intErr := 3;                   // engine busy or in error
         END_IF;
         IF #i_xFromHere AND NOT #tmp_xHere THEN
            #tmp_intErr := 6;                   // scan from here: no length and width, or actual pose not valid
         END_IF;

         IF #tmp_intErr = 0 THEN
            // corner 1: the actual pose with "scan from here", else pose 4
            IF #tmp_xHere THEN
               #tmp_udtC1 := #i_udtActual;
               #intFirst := 4;                  // the robot stands on corner 1: begin with side 1
            ELSE
               #tmp_udtC1 := #i_aoudtP[#P_C1];
               #intFirst := 1;
            END_IF;

            // the other corners and the approach: computed from corner 1, or taught
            IF #tmp_xDim THEN
               #tmp_rRad := #i_rAngle * #DEG_TO_RAD;
               #tmp_rCos := COS(#tmp_rRad);
               #tmp_rSin := SIN(#tmp_rRad);
               #tmp_udtC2 := #tmp_udtC1;                              // + length along the angle
               #tmp_udtC2.rX := #tmp_udtC1.rX + #i_rLength * #tmp_rCos;
               #tmp_udtC2.rY := #tmp_udtC1.rY + #i_rLength * #tmp_rSin;
               #tmp_udtC4 := #tmp_udtC1;                              // + width, 90 deg to the left
               #tmp_udtC4.rX := #tmp_udtC1.rX - #i_rWidth * #tmp_rSin;
               #tmp_udtC4.rY := #tmp_udtC1.rY + #i_rWidth * #tmp_rCos;
               #tmp_udtC3 := #tmp_udtC2;                              // corner 2 + width
               #tmp_udtC3.rX := #tmp_udtC2.rX - #i_rWidth * #tmp_rSin;
               #tmp_udtC3.rY := #tmp_udtC2.rY + #i_rWidth * #tmp_rCos;
               #tmp_udtApp := #tmp_udtC1;                             // above corner 1
               #tmp_udtApp.rZ := #i_rSafeZ;
               // v0.4: the tool turns rotz_step at every corner, -180 -> -90 -> 0 -> +90 -> +180
               #tmp_udtC2.rRotZ := #tmp_udtC1.rRotZ + #ROTZ_STEP;
               #tmp_udtC3.rRotZ := #tmp_udtC1.rRotZ + 2.0 * #ROTZ_STEP;
               #tmp_udtC4.rRotZ := #tmp_udtC1.rRotZ + 3.0 * #ROTZ_STEP;
               #tmp_rRotZEnd := #tmp_udtC1.rRotZ + 4.0 * #ROTZ_STEP;
            ELSE
               #tmp_udtC2 := #i_aoudtP[#P_C2];
               #tmp_udtC3 := #i_aoudtP[#P_C3];
               #tmp_udtC4 := #i_aoudtP[#P_C4];
               #tmp_udtApp := #i_aoudtP[#P_APPROACH];
               #tmp_rRotZEnd := #tmp_udtC1.rRotZ;                     // taught mode: corner 1 as taught
            END_IF;

            // v0.6: no turn. every corner takes the orientation of corner 1, so the turn
            // entries become moves of zero length. they are left out of the push below
            IF #i_xNoTurn THEN
               #tmp_udtC2.rRotZ := #tmp_udtC1.rRotZ;
               #tmp_udtC2.rRotY := #tmp_udtC1.rRotY;
               #tmp_udtC3.rRotZ := #tmp_udtC1.rRotZ;
               #tmp_udtC3.rRotY := #tmp_udtC1.rRotY;
               #tmp_udtC4.rRotZ := #tmp_udtC1.rRotZ;
               #tmp_udtC4.rRotY := #tmp_udtC1.rRotY;
               #tmp_rRotZEnd := #tmp_udtC1.rRotZ;
            END_IF;

            // the 14 poses, goals.md section 3
            #aoudtPoseList[1] := #i_aoudtP[#P_START];
            #aoudtPoseList[2] := #tmp_udtApp;
            #aoudtPoseList[3] := #tmp_udtC1;

            #aoudtPoseList[4] := #tmp_udtC2;                   // side 1: to c2 with the orientation of c1
            #aoudtPoseList[4].rRotZ := #tmp_udtC1.rRotZ;
            #aoudtPoseList[4].rRotY := #tmp_udtC1.rRotY;
            #aoudtPoseList[5] := #tmp_udtC2;                   // turn at c2

            #aoudtPoseList[6] := #tmp_udtC3;                   // side 2
            #aoudtPoseList[6].rRotZ := #tmp_udtC2.rRotZ;
            #aoudtPoseList[6].rRotY := #tmp_udtC2.rRotY;
            #aoudtPoseList[7] := #tmp_udtC3;                   // turn at c3

            #aoudtPoseList[8] := #tmp_udtC4;                   // side 3
            #aoudtPoseList[8].rRotZ := #tmp_udtC3.rRotZ;
            #aoudtPoseList[8].rRotY := #tmp_udtC3.rRotY;
            #aoudtPoseList[9] := #tmp_udtC4;                   // turn at c4

            #aoudtPoseList[10] := #tmp_udtC1;                  // side 4, back to c1
            #aoudtPoseList[10].rRotZ := #tmp_udtC4.rRotZ;
            #aoudtPoseList[10].rRotY := #tmp_udtC4.rRotY;
            #aoudtPoseList[11] := #tmp_udtC1;                  // turn at c1: the fourth turn, +180 in dimension mode
            #aoudtPoseList[11].rRotZ := #tmp_rRotZEnd;

            #aoudtPoseList[12] := #tmp_udtC1;                  // lift, keeps the last orientation
            #aoudtPoseList[12].rRotZ := #tmp_rRotZEnd;
            #aoudtPoseList[12].rZ := #i_rSafeZ;
            #aoudtPoseList[13] := #i_aoudtP[#P_START];
            #intListLen := 13;
            IF #i_aoxValid[#P_HOME] THEN
               #aoudtPoseList[14] := #i_aoudtP[#P_HOME];
               #intListLen := 14;
            END_IF;

            // every pose that will be pushed is checked before the first one goes out, rule 9.
            // a wrong length or width puts a computed corner outside the limits: error 4 with its index
            FOR #tmp_i := #intFirst TO #intListLen DO
               #tmp_intPoseErr := "FC_PoseCheck"(i_udtPose := #aoudtPoseList[#tmp_i]);
               IF #tmp_intPoseErr <> 0 AND #tmp_intErr = 0 THEN
                  #tmp_intErr := 4;             // a pose of the job is outside the limits
                  #o_udtState.intMoveActive := #tmp_i;
               END_IF;
               #aoudtList[#tmp_i].intBlock := #BLOCK_LIN;
               #aoudtList[#tmp_i].udtPose := #aoudtPoseList[#tmp_i];
               #aoudtList[#tmp_i].udtPose2 := #aoudtPoseList[#tmp_i];
               #aoudtList[#tmp_i].rBlend := 0.0;
               #aoudtList[#tmp_i].aorPar[1] := 0.0;
               #aoudtList[#tmp_i].aorPar[2] := 0.0;
               #aoudtList[#tmp_i].aorPar[3] := 0.0;
               #aoudtList[#tmp_i].intOverride := #i_intOverride;
               #aoudtList[#tmp_i].xStopOnSensor := FALSE;
               #aoudtList[#tmp_i].intId := #tmp_i;
               #aoudtList[#tmp_i].intPathLen := 0;           // v0.5: a single move
            END_FOR;

            // v0.5: what goes out, in order. v0.6: with no turn the turn entries 5, 7, 9, 11 stay out
            #intOutLen := 0;
            IF #i_xPathMode THEN
               FOR #tmp_i := #intFirst TO #PATH_FIRST - 1 DO          // the singles before the rectangle
                  #intOutLen := #intOutLen + 1;
                  #aoudtOut[#intOutLen] := #aoudtList[#tmp_i];
               END_FOR;
               #intOutLen := #intOutLen + 1;                            // the rectangle, one entry
               #aoudtOut[#intOutLen] := #aoudtList[#PATH_LAST];         // block, pose, override from the last side
               #aoudtOut[#intOutLen].intBlock := #BLOCK_RECT;
               #aoudtOut[#intOutLen].intId := #ID_PATH;
               #tmp_intSeg := 0;
               FOR #tmp_k := #PATH_FIRST TO #PATH_LAST DO
                  #tmp_xTurn := #tmp_k = 5 OR #tmp_k = 7 OR #tmp_k = 9;
                  IF NOT (#i_xNoTurn AND #tmp_xTurn) THEN
                     #tmp_intSeg := #tmp_intSeg + 1;
                     #aoudtOut[#intOutLen].aoudtPath[#tmp_intSeg] := #aoudtPoseList[#tmp_k];
                  END_IF;
               END_FOR;
               #aoudtOut[#intOutLen].intPathLen := #tmp_intSeg;        // 7, or 4 with no turn
               FOR #tmp_i := #PATH_LAST + 1 TO #intListLen DO           // turn at c1, lift, start, home
                  #tmp_xTurn := #tmp_i = 11;
                  IF NOT (#i_xNoTurn AND #tmp_xTurn) THEN
                     #intOutLen := #intOutLen + 1;
                     #aoudtOut[#intOutLen] := #aoudtList[#tmp_i];
                  END_IF;
               END_FOR;
            ELSE
               FOR #tmp_i := #intFirst TO #intListLen DO
                  #tmp_xTurn := #tmp_i = 5 OR #tmp_i = 7 OR #tmp_i = 9 OR #tmp_i = 11;
                  IF NOT (#i_xNoTurn AND #tmp_xTurn) THEN
                     #intOutLen := #intOutLen + 1;
                     #aoudtOut[#intOutLen] := #aoudtList[#tmp_i];
                  END_IF;
               END_FOR;
            END_IF;
         END_IF;

         IF #tmp_intErr <> 0 THEN
            #o_udtState.intErrId := #tmp_intErr;
            #intStep := 90;
         ELSE
            #o_xClear := TRUE;                  // whatever was left in the queue goes
            #intPushIdx := 1;
            #o_udtState.intMovesTotal := #intOutLen;
            #o_udtState.intMovesDone := 0;
            #o_udtState.intMoveActive := 0;
            #o_udtState.xRunning := TRUE;
            #intStep := 20;
         END_IF;

      20: // push one entry per cycle
         #o_udtPush := #aoudtOut[#intPushIdx];
         #o_xPushReq := TRUE;
         #intPushIdx := #intPushIdx + 1;
         IF #intPushIdx > #intOutLen THEN
            #intStep := 30;
         END_IF;

      30: // run. the engine eats the queue, this block only counts
         IF #i_udtMoveState.xBusy THEN
            #o_udtState.intMoveActive := #i_udtMoveState.intIdActive;
         END_IF;
         IF #i_udtMoveState.xDone THEN
            #o_udtState.intMovesDone := #o_udtState.intMovesDone + 1;
         END_IF;
         IF #i_intQueueCount = 0 AND NOT #i_udtMoveState.xBusy AND NOT #i_udtMoveState.xDone THEN
            #o_udtState.xRunning := FALSE;
            #o_udtState.xDone := TRUE;
            #intStep := 0;
         END_IF;

      90: // error. stays until abort or the next start
         #o_udtState.xRunning := FALSE;
         #o_udtState.xError := TRUE;
         IF #tmp_xAbortEdge THEN
            #o_udtState.xError := FALSE;
            #o_udtState.intErrId := 0;
            #intStep := 0;
         END_IF;
   END_CASE;

   #o_udtState.intStep := #intStep;

   // job error numbers
   //  1 a cube pose is not taught: taught mode 2..7, dimension mode 2 and 4, scan from here 2
   //  2 safe z not set                          4 a pose of the job is outside the limits, see intMoveActive
   //  3 engine busy or in error at start        6 scan from here not possible: no length and width, or the robot is not referenced
   // 10 the engine went into error, see intEngineErr
END_FUNCTION_BLOCK
