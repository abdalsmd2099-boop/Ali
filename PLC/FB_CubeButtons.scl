FUNCTION_BLOCK "FB_CubeButtons"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
// v0.2 (2026-11-11): a go to writes the whole hand request, not only pose and block: id = the
// pose number (hmi text), no path, no parameters. before, intPathLen and aorPar kept whatever
// stood in the db, and a go to could become a path move with stale poses.
// 2026-11-03. the buttons and lamps of the cube box on the automatic screen, without any
// hmi script. every button of the screen writes ONE bit into "DB_RobotHand".Btn, this block
// turns the bits into what the other blocks expect:
//    teach home / start / corner 1, teach nr, clear nr  -> the pose number and a one-cycle
//                                                           pulse for fb_teach
//    go to start / go to corner 1                       -> the pose into the hand target,
//                                                           block 1, a one-cycle start pulse
//    ack                                                 -> reset for the engine and abort for
//                                                           the job, one cycle
//    lamps: teach allowed, go allowed, cube ready, corners computed
//
// runs in ob1 after the robot mode network and BEFORE the teach network, so a pulse is seen
// in the same cycle by fb_teach, the engine and the job. instance "IDB_CubeButtons".
//
// one writer: this block is the one writer of "DB_RobotJob".Teach.intPoseNr, .xTeach, .xClear.
// the pose nr field and the TEACH / CLEAR buttons of the screen write "DB_RobotHand".Btn
// instead of those tags (hmi_cube_howto.md).
// documented exception: on a go to edge it writes "DB_RobotMove".Man.udtReq.udtPose and
// .intBlock and pulses Man.xStart; on ack it pulses Man.xReset and "DB_RobotJob".Man.xAbort.
// the screen's MOVE, RESET and ABORT write the same bits on operator action. both are
// operator actions, like typing a pose, never in the same cycle on purpose.
   VAR_INPUT
      i_xTeachHome : Bool;                      // "DB_RobotHand".Btn.xTeachHome, momentary
      i_xTeachStart : Bool;                     // .Btn.xTeachStart
      i_xTeachC1 : Bool;                        // .Btn.xTeachC1
      i_xTeachNr : Bool;                        // .Btn.xTeachNr, the generic TEACH button
      i_xClearNr : Bool;                        // .Btn.xClearNr, the generic CLEAR button
      i_intPoseNrReq : Int;                     // .Btn.intPoseNr, the pose nr field, 1..50
      i_xGoStart : Bool;                        // .Btn.xGoStart
      i_xGoC1 : Bool;                           // .Btn.xGoC1
      i_xAck : Bool;                            // .Btn.xAck
      i_aoudtP : Array[1..50] of "UDT_Pose";    // "DB_Poses".aoudtP
      i_aoxValid : Array[1..50] of Bool;        // "DB_Poses".aoxValid
      i_rLength : Real;                         // "DB_Recipe".Cube.rLength
      i_rWidth : Real;                          // "DB_Recipe".Cube.rWidth
      i_xEnable : Bool;                         // "DB_RobotMove".Man.xEnable
      i_xAuto : Bool;                           // "DB_RobotJob".Man.xAuto
      i_xEngineBusy : Bool;                     // "DB_RobotMove".State.xBusy
   END_VAR

   VAR_OUTPUT
      o_intPoseNr : Int;                        // => "DB_RobotJob".Teach.intPoseNr
      o_xTeach : Bool;                          // => "DB_RobotJob".Teach.xTeach, one cycle
      o_xClear : Bool;                          // => "DB_RobotJob".Teach.xClear, one cycle
      o_xTeachAllowed : Bool;                   // => "DB_RobotHand".Lamp.xTeachAllowed, enables the teach buttons
      o_xGoAllowed : Bool;                      // => .Lamp.xGoAllowed, enables the go to buttons
      o_xCubeReady : Bool;                      // => .Lamp.xCubeReady, home + start + corner 1 taught
      o_xComputed : Bool;                       // => .Lamp.xComputed, "computed from corner 1" text
   END_VAR

   VAR_IN_OUT
      io_udtMan : "UDT_MoveReq";                // "DB_RobotMove".Man.udtReq, written on a go to edge
      io_xManStart : Bool;                      // "DB_RobotMove".Man.xStart, pulsed on a go to edge
      io_xReset : Bool;                         // "DB_RobotMove".Man.xReset, pulsed on ack
      io_xAbort : Bool;                         // "DB_RobotJob".Man.xAbort, pulsed on ack
   END_VAR

   VAR
      xHomeOld : Bool;
      xStartOld : Bool;
      xC1Old : Bool;
      xNrOld : Bool;
      xClearOld : Bool;
      xGoStartOld : Bool;
      xGoC1Old : Bool;
      xAckOld : Bool;
      xGoPulse : Bool;                          // the start pulse of a go to is high, clear it next cycle
      xAckPulse : Bool;                         // the ack pulse is high, clear it next cycle
   END_VAR

   VAR_TEMP
      tmp_xInRange : Bool;
   END_VAR

   VAR CONSTANT
      P_HOME : Int := 1;
      P_START : Int := 2;
      P_C1 : Int := 4;
      BLOCK_LIN : Int := 1;
   END_VAR

BEGIN
   // ---- lamps and permissions -------------------------------------------------------
   #o_xTeachAllowed := #i_xEnable AND NOT #i_xAuto AND NOT #i_xEngineBusy;
   #o_xGoAllowed := #o_xTeachAllowed;
   #o_xCubeReady := #i_aoxValid[#P_HOME] AND #i_aoxValid[#P_START] AND #i_aoxValid[#P_C1];
   #o_xComputed := #i_rLength > 0.0 AND #i_rWidth > 0.0;

   // range check on its own line, rule 8
   #tmp_xInRange := #i_intPoseNrReq >= 1 AND #i_intPoseNrReq <= 50;

   // ---- teach: the number of the button and a one-cycle pulse. fb_teach checks allowed and valid itself
   #o_xTeach := FALSE;
   #o_xClear := FALSE;
   IF #i_xTeachHome AND NOT #xHomeOld THEN
      #o_intPoseNr := #P_HOME;
      #o_xTeach := TRUE;
   ELSIF #i_xTeachStart AND NOT #xStartOld THEN
      #o_intPoseNr := #P_START;
      #o_xTeach := TRUE;
   ELSIF #i_xTeachC1 AND NOT #xC1Old THEN
      #o_intPoseNr := #P_C1;
      #o_xTeach := TRUE;
   ELSIF #i_xTeachNr AND NOT #xNrOld AND #tmp_xInRange THEN
      #o_intPoseNr := #i_intPoseNrReq;
      #o_xTeach := TRUE;
   ELSIF #i_xClearNr AND NOT #xClearOld AND #tmp_xInRange THEN
      #o_intPoseNr := #i_intPoseNrReq;
      #o_xClear := TRUE;
   END_IF;
   #xHomeOld := #i_xTeachHome;
   #xStartOld := #i_xTeachStart;
   #xC1Old := #i_xTeachC1;
   #xNrOld := #i_xTeachNr;
   #xClearOld := #i_xClearNr;

   // ---- go to: the pose into the hand target, block 1, one-cycle start. only when allowed ------
   IF #xGoPulse THEN
      #io_xManStart := FALSE;
      #xGoPulse := FALSE;
   END_IF;
   IF #o_xGoAllowed THEN
      IF #i_xGoStart AND NOT #xGoStartOld AND #i_aoxValid[#P_START] THEN
         #io_udtMan.udtPose := #i_aoudtP[#P_START];
         #io_udtMan.intBlock := #BLOCK_LIN;
         #io_udtMan.intId := #P_START;           // v0.2: the whole request is ours on a go to
         #io_udtMan.intPathLen := 0;
         #io_udtMan.rBlend := 0.0;
         #io_udtMan.aorPar[1] := 0.0;
         #io_udtMan.aorPar[2] := 0.0;
         #io_udtMan.aorPar[3] := 0.0;
         #io_xManStart := TRUE;
         #xGoPulse := TRUE;
      ELSIF #i_xGoC1 AND NOT #xGoC1Old AND #i_aoxValid[#P_C1] THEN
         #io_udtMan.udtPose := #i_aoudtP[#P_C1];
         #io_udtMan.intBlock := #BLOCK_LIN;
         #io_udtMan.intId := #P_C1;
         #io_udtMan.intPathLen := 0;
         #io_udtMan.rBlend := 0.0;
         #io_udtMan.aorPar[1] := 0.0;
         #io_udtMan.aorPar[2] := 0.0;
         #io_udtMan.aorPar[3] := 0.0;
         #io_xManStart := TRUE;
         #xGoPulse := TRUE;
      END_IF;
   END_IF;
   #xGoStartOld := #i_xGoStart;
   #xGoC1Old := #i_xGoC1;

   // ---- ack: reset the engine and abort the job, one cycle -------------------------------------
   IF #xAckPulse THEN
      #io_xReset := FALSE;
      #io_xAbort := FALSE;
      #xAckPulse := FALSE;
   END_IF;
   IF #i_xAck AND NOT #xAckOld THEN
      #io_xReset := TRUE;
      #io_xAbort := TRUE;
      #xAckPulse := TRUE;
   END_IF;
   #xAckOld := #i_xAck;
END_FUNCTION_BLOCK
