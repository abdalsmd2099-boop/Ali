DATA_BLOCK "DB_Scan"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
"UDT_ScanRect"

BEGIN
   // the standard rectangle, the hmi may change these, set the db retentive in its properties
   X0 := 1000.0;
   Y0 := 500.0;
   Z0 := 300.0;
   RotZ := 0.0;
   RotY := 0.0;
   Lx := 300.0;
   Ly := 200.0;
   Py := 50.0;
   Px := 0.0;
   Over := 20.0;
   Vscan := 50.0;
   Vmove := 200.0;
   Zsafe := 600.0;

END_DATA_BLOCK
