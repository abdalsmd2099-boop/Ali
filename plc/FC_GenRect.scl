FUNCTION "FC_GenRect" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// builds the point list for one rectangle scan
// rows: approach above the first corner, down, serpentine lanes, retract
// returns 0 = ok, 1 = bad parameters, 2 = list full, 3 = point outside the fence
// on any error the list is empty, a half list must never run
   VAR_INPUT
      i_scan : "UDT_ScanRect";
   END_VAR

   VAR_IN_OUT
      io_job : "UDT_Job";
   END_VAR

   VAR_TEMP
      iLanes : Int;
      iLane : Int;
      iPts : Int;
      iK : Int;
      iErr : Int;
      rY : Real;
      rXs : Real;
      rXe : Real;
      rDir : Real;
      rOver : Real;
      rX0s : Real;
      rSec : Real;
      rDx : Real;
      rDy : Real;
      rDz : Real;
      xPointMode : Bool;
   END_VAR


BEGIN
   #io_job.Count := 0;
   #io_job.RowIdx := 0;

   // whole mm only, the bus carries no decimals, the hmi limits keep the operator inside that
   IF #i_scan.Lx <= 0.0 OR #i_scan.Ly <= 0.0 OR #i_scan.Py <= 0.0 OR #i_scan.Px < 0.0
      OR #i_scan.Over < 0.0 OR #i_scan.Vscan <= 0.0 OR #i_scan.Vmove <= 0.0
      OR #i_scan.Zsafe <= #i_scan.Z0 THEN
      #FC_GenRect := 1;
      RETURN;
   END_IF;

   #xPointMode := #i_scan.Px > 0.0;

   // overscan only on the slow lanes: the gantry is at speed when it enters the rectangle
   IF #xPointMode THEN
      #rOver := 0.0;
   ELSE
      #rOver := #i_scan.Over;
   END_IF;
   #rX0s := #i_scan.X0 - #rOver;

   // lanes across the rectangle, the last lane lies on or inside the far edge
   #iLanes := 1;
   WHILE INT_TO_REAL(#iLanes) * #i_scan.Py <= #i_scan.Ly AND #iLanes < 80 DO
      #iLanes := #iLanes + 1;
   END_WHILE;

   // points along one lane, point mode only
   #iPts := 1;
   IF #xPointMode THEN
      WHILE INT_TO_REAL(#iPts) * #i_scan.Px <= #i_scan.Lx AND #iPts < 80 DO
         #iPts := #iPts + 1;
      END_WHILE;
   END_IF;

   // approach: above the start of lane 0 at safe height, then straight down to scan height
   #iErr := "FC_AddRow"(i_rX := #rX0s,
                        i_rY := #i_scan.Y0,
                        i_rZ := #i_scan.Zsafe,
                        i_rRotZ := #i_scan.RotZ,
                        i_rRotY := #i_scan.RotY,
                        i_iBlock := 1,
                        i_rSpeed := #i_scan.Vmove,
                        i_xScanOn := FALSE,
                        i_xMeasure := FALSE,
                        i_fence := #io_job.Fence,
                        io_rows := #io_job.Rows,
                        io_n := #io_job.Count);
   IF #iErr = 0 THEN
      #iErr := "FC_AddRow"(i_rX := #rX0s,
                           i_rY := #i_scan.Y0,
                           i_rZ := #i_scan.Z0,
                           i_rRotZ := #i_scan.RotZ,
                           i_rRotY := #i_scan.RotY,
                           i_iBlock := 1,
                           i_rSpeed := #i_scan.Vmove,
                           i_xScanOn := FALSE,
                           i_xMeasure := #xPointMode,
                           i_fence := #io_job.Fence,
                           io_rows := #io_job.Rows,
                           io_n := #io_job.Count);
   END_IF;

   FOR #iLane := 0 TO #iLanes - 1 DO
      IF #iErr <> 0 THEN
         EXIT;
      END_IF;

      #rY := #i_scan.Y0 + INT_TO_REAL(#iLane) * #i_scan.Py;

      // even lanes run +x, odd lanes run back -x, so the gantry never crosses the rectangle
      IF (#iLane MOD 2) = 0 THEN
         #rXs := #i_scan.X0 - #rOver;
         #rXe := #i_scan.X0 + #i_scan.Lx + #rOver;
         #rDir := 1.0;
      ELSE
         #rXs := #i_scan.X0 + #i_scan.Lx + #rOver;
         #rXe := #i_scan.X0 - #rOver;
         #rDir := -1.0;
      END_IF;

      // sidestep to the start of this lane, lane 0 is already there after the approach
      IF #iLane > 0 THEN
         #iErr := "FC_AddRow"(i_rX := #rXs,
                              i_rY := #rY,
                              i_rZ := #i_scan.Z0,
                              i_rRotZ := #i_scan.RotZ,
                              i_rRotY := #i_scan.RotY,
                              i_iBlock := 1,
                              i_rSpeed := #i_scan.Vmove,
                              i_xScanOn := FALSE,
                              i_xMeasure := #xPointMode,
                              i_fence := #io_job.Fence,
                              io_rows := #io_job.Rows,
                              io_n := #io_job.Count);
      END_IF;

      IF #iErr = 0 THEN
         IF NOT #xPointMode THEN
            // one slow line over the whole lane, the scanner records while moving
            #iErr := "FC_AddRow"(i_rX := #rXe,
                                 i_rY := #rY,
                                 i_rZ := #i_scan.Z0,
                                 i_rRotZ := #i_scan.RotZ,
                                 i_rRotY := #i_scan.RotY,
                                 i_iBlock := 2,
                                 i_rSpeed := #i_scan.Vscan,
                                 i_xScanOn := TRUE,
                                 i_xMeasure := FALSE,
                                 i_fence := #io_job.Fence,
                                 io_rows := #io_job.Rows,
                                 io_n := #io_job.Count);
         ELSE
            // a stop and one measurement every px along the lane
            FOR #iK := 1 TO #iPts - 1 DO
               #iErr := "FC_AddRow"(i_rX := #rXs + #rDir * INT_TO_REAL(#iK) * #i_scan.Px,
                                    i_rY := #rY,
                                    i_rZ := #i_scan.Z0,
                                    i_rRotZ := #i_scan.RotZ,
                                    i_rRotY := #i_scan.RotY,
                                    i_iBlock := 2,
                                    i_rSpeed := #i_scan.Vscan,
                                    i_xScanOn := FALSE,
                                    i_xMeasure := TRUE,
                                    i_fence := #io_job.Fence,
                                    io_rows := #io_job.Rows,
                                    io_n := #io_job.Count);
               IF #iErr <> 0 THEN
                  EXIT;
               END_IF;
            END_FOR;
         END_IF;
      END_IF;
   END_FOR;

   // retract straight up from the last point, so the list always ends at safe height
   IF #iErr = 0 THEN
      #iErr := "FC_AddRow"(i_rX := #io_job.Rows[#io_job.Count].Pose.X,
                           i_rY := #io_job.Rows[#io_job.Count].Pose.Y,
                           i_rZ := #i_scan.Zsafe,
                           i_rRotZ := #i_scan.RotZ,
                           i_rRotY := #i_scan.RotY,
                           i_iBlock := 1,
                           i_rSpeed := #i_scan.Vmove,
                           i_xScanOn := FALSE,
                           i_xMeasure := FALSE,
                           i_fence := #io_job.Fence,
                           io_rows := #io_job.Rows,
                           io_n := #io_job.Count);
   END_IF;

   IF #iErr <> 0 THEN
      #io_job.Count := 0;
      #io_job.Lanes := 0;
      #io_job.EstTimeS := 0;
   ELSE
      // rough job time for the screen: path over speed, plus start and finish of every row
      // the first retract from wherever the gantry stands is a guess
      #io_job.Lanes := #iLanes;
      #rSec := 5.0;
      FOR #iK := 2 TO #io_job.Count DO
         #rDx := #io_job.Rows[#iK].Pose.X - #io_job.Rows[#iK - 1].Pose.X;
         #rDy := #io_job.Rows[#iK].Pose.Y - #io_job.Rows[#iK - 1].Pose.Y;
         #rDz := #io_job.Rows[#iK].Pose.Z - #io_job.Rows[#iK - 1].Pose.Z;
         #rSec := #rSec + SQRT(#rDx * #rDx + #rDy * #rDy + #rDz * #rDz) / #io_job.Rows[#iK].Speed + 0.3;
      END_FOR;
      #io_job.EstTimeS := REAL_TO_INT(#rSec);
   END_IF;
   #FC_GenRect := #iErr;
END_FUNCTION
