TYPE "UDT_Scanner"
VERSION : 0.1
   STRUCT
      ScanOn : Bool;      // plc to scanner, record while true
      Trigger : Bool;     // plc to scanner, one measurement, held until measdone
      RowTag : Int;       // plc to scanner, row number to tag the data with
      MeasDone : Bool;    // scanner to plc
      Ready : Bool;       // scanner to plc
      Error : Bool;       // scanner to plc
   END_STRUCT;

END_TYPE
