TYPE "UDT_Row"
VERSION : 0.1
   STRUCT
      Pose : "UDT_Pose5";
      Block : Int;       // 1 lin fast, 2 lin slow, 3 circ ccw, 4 circ cw
      Speed : Real;      // mm/s, only for the move timeout, same value as programmed in the robot
      Radius : Real;     // mm, circ only
      ScanOn : Bool;     // the scanner records while this move runs
      Measure : Bool;    // one measurement after this move, the job waits for it
   END_STRUCT;

END_TYPE
