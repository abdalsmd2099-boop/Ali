TYPE "UDT_LineGeo"
VERSION : 0.1
// 2026-11-09. the geometry of one line scan, frozen by fb_scanlinejob v0.2 in its step 10 when the
// job starts. fc_linemove computes every move of the job from it and the move index, so the job
// keeps no list of moves any more (v0.1 kept 203 entries in arrays, which capped the job at 50
// lines). a change on the hmi during the run does not reach a running job: the job reads this copy.
// rule: a new field goes at the end. existing names never change.
   STRUCT
      intCount : Int;                 // lines in the job, 1 .. (typed, or computed in area mode)
      intFirst : Int;                 // 1 = move 1 is "to start" (pose 2). 2 = scan from here, the list begins above line 0
      xHome : Bool;                   // the last move is home (pose 1 is taught)
      xLift : Bool;                   // lift, travel, down between two lines (3 moves) instead of one index move
      xZigzag : Bool;                 // every odd line runs backwards (serpentine)
      rA0X : Real;                    // mm, the start of the patch of line 0 (pose 9, or the actual pose, or corner 1 in area mode)
      rA0Y : Real;
      rRotY : Real;                   // deg, roty of every computed point (from pose 9 or the actual pose)
      rDirX : Real;                   // d, the line direction, unit vector. in area mode it may be turned by 180 so that it points to corner 2
      rDirY : Real;
      rIdxX : Real;                   // the index direction, unit vector: e = (-dy, dx) across the lines, or d with index along
      rIdxY : Real;
      rPitch : Real;                  // mm, signed, start to start between two lines. the sign is the side
      rLength : Real;                 // mm, the patch of every line
      rLeadIn : Real;                 // mm, before the patch and after it
      rZ : Real;                      // mm, scan height
      rSafeZ : Real;                  // mm
      rLiftZ : Real;                  // mm, the height of the travel with xLift (the recipe's lift z, or safe z when that is 0)
      rRotZEven : Real;               // deg, rotz of the even lines
      rRotZOdd : Real;                // deg, rotz of the odd lines. = rRotZEven without zigzag, or with no turn
      udtPStart : "UDT_Pose";         // pose 2, the start
      udtPHome : "UDT_Pose";          // pose 1, home. used only with xHome
      intMoves : Int;                 // moves in the job: (intFirst = 1 ? 1 : 0) + 3 + (intCount - 1) * (2 or 4 with xLift) + 2 + (xHome ? 1 : 0)
   END_STRUCT;

END_TYPE
